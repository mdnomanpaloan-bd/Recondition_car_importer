<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #1e1e2e; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.recondition_car_importer.Sifat.TrackProfitController">
    <children>
        <Label text="Track Profit, Revenue &amp; Profit Margin" textFill="WHITE">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <HBox spacing="15.0">
            <children>
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #2b2b3b; -fx-padding: 15; -fx-background-radius: 8;">
                    <children>
                        <Label text="Gross Revenue" textFill="#a6adc8" />
                        <Label fx:id="lblTotalRevenue" text="BDT 0.00" textFill="#a6e3a1">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #2b2b3b; -fx-padding: 15; -fx-background-radius: 8;">
                    <children>
                        <Label text="Total Expenses" textFill="#a6adc8" />
                        <Label fx:id="lblTotalExpenses" text="BDT 0.00" textFill="#f38ba8">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #2b2b3b; -fx-padding: 15; -fx-background-radius: 8;">
                    <children>
                        <Label text="Net Operating Profit" textFill="#a6adc8" />
                        <Label fx:id="lblNetProfit" text="BDT 0.00" textFill="#89b4fa">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #2b2b3b; -fx-padding: 15; -fx-background-radius: 8;">
                    <children>
                        <Label text="Profit Margin" textFill="#a6adc8" />
                        <Label fx:id="lblProfitMargin" text="0.00%" textFill="#f9e2af">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
            <children>
                <PieChart fx:id="pieChartRevenueExpense" title="Revenue vs Expenses Allocation" style="-fx-background-color: #2b2b3b; -fx-background-radius: 8; -fx-padding: 10;" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </children>
</VBox>
