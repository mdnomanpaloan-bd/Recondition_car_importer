<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #1e1e2e; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.recondition_car_importer.Sifat.TrackSalesBookingController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <Label text="Track Vehicle Sales &amp; Booking Status" textFill="WHITE" HBox.hgrow="ALWAYS">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Filter by Status:" textFill="#a6adc8" />
                <ComboBox fx:id="comboFilterStatus" onAction="#handleFilterChange" prefWidth="150.0" />
            </children>
        </HBox>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="trackingTable" HBox.hgrow="ALWAYS" style="-fx-background-color: #2b2b3b;">
                    <columns>
                        <TableColumn fx:id="colCarId" prefWidth="100.0" text="Car ID" />
                        <TableColumn fx:id="colModel" prefWidth="200.0" text="Model" />
                        <TableColumn fx:id="colCustomer" prefWidth="160.0" text="Customer Name" />
                        <TableColumn fx:id="colBookingDate" prefWidth="120.0" text="Booking Date" />
                        <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                    </columns>
                </TableView>

                <VBox prefWidth="300.0" spacing="15.0" style="-fx-background-color: #2b2b3b; -fx-padding: 15; -fx-background-radius: 8;">
                    <children>
                        <Label text="Update Status Form" textFill="#a6adc8">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label text="Customer Name:" textFill="WHITE" />
                        <TextField fx:id="txtCustomerName" promptText="Enter Customer Name" />

                        <Label text="New Status:" textFill="WHITE" />
                        <ComboBox fx:id="comboUpdateStatus" maxWidth="1.7976931348623157E308" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleUpdateStatus" style="-fx-background-color: #89b4fa; -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-padding: 10;" text="Update Status" />

                        <Label fx:id="lblMessage" textFill="#a6e3a1" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
