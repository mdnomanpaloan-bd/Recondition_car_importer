<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #1e1e2e; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.recondition_car_importer.Sifat.AssignSalesController">
    <children>
        <Label text="Assign Cars to Sales Representatives" textFill="WHITE">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <HBox spacing="15.0" style="-fx-background-color: #2b2b3b; -fx-padding: 15; -fx-background-radius: 8;">
            <children>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Select Car" textFill="#a6adc8" />
                        <ComboBox fx:id="comboCar" maxWidth="1.7976931348623157E308" promptText="Choose Car" />
                    </children>
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Select Sales Rep" textFill="#a6adc8" />
                        <ComboBox fx:id="comboSalesRep" maxWidth="1.7976931348623157E308" promptText="Choose Sales Rep" />
                    </children>
                </VBox>
                <VBox alignment="BOTTOM_LEFT">
                    <children>
                        <Button onAction="#handleAssignRep" style="-fx-background-color: #89b4fa; -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-padding: 8 20;" text="Assign Rep" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <Label fx:id="lblMessage" textFill="#a6e3a1">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <TableView fx:id="assignmentTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #2b2b3b;">
            <columns>
                <TableColumn fx:id="colCarId" prefWidth="120.0" text="Car ID" />
                <TableColumn fx:id="colModel" prefWidth="250.0" text="Model" />
                <TableColumn fx:id="colAssignedRep" prefWidth="200.0" text="Assigned Rep" />
                <TableColumn fx:id="colDate" prefWidth="150.0" text="Assignment Date" />
            </columns>
        </TableView>
    </children>
</VBox>
