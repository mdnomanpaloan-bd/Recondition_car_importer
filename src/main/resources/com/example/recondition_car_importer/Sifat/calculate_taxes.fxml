<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #1e1e2e; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.recondition_car_importer.Sifat.CalculateTaxesController">
    <children>
        <Label text="Calculate Taxes, Import Duty &amp; Customs" textFill="WHITE">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox prefWidth="350.0" spacing="15.0" style="-fx-background-color: #2b2b3b; -fx-padding: 20; -fx-background-radius: 8;">
                    <children>
                        <Label text="Vehicle Import Details" textFill="#a6adc8">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <Label text="Car Import Value (BDT):" textFill="WHITE" />
                        <TextField fx:id="txtImportValue" promptText="e.g. 2000000" />

                        <Label text="Engine Capacity (CC):" textFill="WHITE" />
                        <TextField fx:id="txtEngineCC" promptText="e.g. 1800" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleCalculateTax" style="-fx-background-color: #89b4fa; -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-padding: 10;" text="Calculate Tax" />

                        <Label fx:id="lblMessage" textFill="#f9e2af" wrapText="true" />
                    </children>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" spacing="15.0" style="-fx-background-color: #2b2b3b; -fx-padding: 20; -fx-background-radius: 8;">
                    <children>
                        <Label text="Tax Breakdown Summary" textFill="#a6adc8">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>

                        <VBox spacing="10.0" style="-fx-background-color: #181825; -fx-padding: 20; -fx-background-radius: 8;">
                            <children>
                                <Label fx:id="lblDutyAmount" text="Import Duty Amount: BDT 0.00" textFill="WHITE">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblVatAmount" text="VAT Amount: BDT 0.00" textFill="WHITE">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>
                                <Separator style="-fx-background-color: #45475a;" />
                                <Label fx:id="lblTotalTax" text="Total Payable Customs Tax: BDT 0.00" textFill="#a6e3a1">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
