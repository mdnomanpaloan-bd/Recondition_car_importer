<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #1e1e2e; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.recondition_car_importer.Sifat.FinancialAuditController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Generate Financial Audit &amp; Tax Reports" textFill="WHITE" HBox.hgrow="ALWAYS">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="From:" textFill="#a6adc8" />
                <DatePicker fx:id="startDatePicker" prefWidth="130.0" />
                <Label text="To:" textFill="#a6adc8" />
                <DatePicker fx:id="endDatePicker" prefWidth="130.0" />
                <Button onAction="#handleRunAudit" style="-fx-background-color: #89b4fa; -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-padding: 8 15;" text="Run Audit" />
                <Button onAction="#handleSaveReport" style="-fx-background-color: #a6e3a1; -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-padding: 8 15;" text="Save Report" />
            </children>
        </HBox>

        <Label fx:id="lblMessage" textFill="#f9e2af" wrapText="true">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <TextArea fx:id="txtAuditSummary" editable="false" prefHeight="400.0" style="-fx-control-inner-background: #181825; -fx-font-family: 'Courier New'; -fx-font-size: 13;" VBox.vgrow="ALWAYS" wrapText="true" />
    </children>
</VBox>
