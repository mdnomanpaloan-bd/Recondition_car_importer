<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #1e1e2e; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.recondition_car_importer.Sifat.CarFinancingController">
    <children>
        <Label text="Approve Car Financing &amp; Loans" textFill="WHITE">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="loanTable" HBox.hgrow="ALWAYS" style="-fx-background-color: #2b2b3b;">
                    <columns>
                        <TableColumn fx:id="colAppId" prefWidth="90.0" text="App ID" />
                        <TableColumn fx:id="colApplicant" prefWidth="150.0" text="Applicant Name" />
                        <TableColumn fx:id="colAmount" prefWidth="120.0" text="Loan Amount" />
                        <TableColumn fx:id="colDuration" prefWidth="90.0" text="Months" />
                        <TableColumn fx:id="colInterest" prefWidth="90.0" text="Rate %" />
                        <TableColumn fx:id="colEmi" prefWidth="120.0" text="Monthly EMI" />
                        <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
                    </columns>
                </TableView>

                <VBox prefWidth="300.0" spacing="15.0" style="-fx-background-color: #2b2b3b; -fx-padding: 15; -fx-background-radius: 8;">
                    <children>
                        <Label text="Loan Approval &amp; EMI Calculator" textFill="#a6adc8">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <Label text="Interest Rate (% Per Annum):" textFill="WHITE" />
                        <TextField fx:id="txtInterestRate" promptText="e.g. 9.5" />

                        <Label fx:id="lblEmiDisplay" text="Calculated Monthly EMI: BDT 0.00" textFill="#89b4fa" wrapText="true">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <HBox spacing="10.0">
                            <children>
                                <Button HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" onAction="#handleApproveLoan" style="-fx-background-color: #a6e3a1; -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-padding: 10;" text="Approve" />
                                <Button HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" onAction="#handleRejectLoan" style="-fx-background-color: #f38ba8; -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-padding: 10;" text="Reject" />
                            </children>
                        </HBox>

                        <Label fx:id="lblMessage" textFill="#f9e2af" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
