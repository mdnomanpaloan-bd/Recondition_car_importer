<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="780.0" prefWidth="1240.0" style="-fx-background-color: #181825;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.recondition_car_importer.Sifat.SifatDashboardController">
    <left>
        <VBox prefWidth="300.0" spacing="12.0" style="-fx-background-color: #11111b; -fx-padding: 18;">
            <children>
                <Label text="Reconditioned Car System" textFill="#89b4fa">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <Label text="Importers &amp; Showroom Portal (Sifat)" textFill="#a6adc8">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>

                <Separator style="-fx-background-color: #313244;" />

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="8.0">
                            <children>
                                <!-- USER 5: SHOWROOM MANAGER GOALS -->
                                <Label text="USER 5: SHOWROOM MANAGER" textFill="#f9e2af">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets top="5.0" />
                                    </VBox.margin>
                                </Label>
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal1" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="1. Manage Inventory" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal2" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="2. Assign Sales Reps" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal3" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="3. Vehicle Pricing &amp; Discounts" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal4" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="4. Approve Test Drive Requests" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal5" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="5. Monitor Sales Rep Performance" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal6" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="6. Track Sales &amp; Bookings" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal7" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="7. Customer Complaints &amp; Escalations" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal8" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="8. Monthly Sales Reports" />

                                <Separator style="-fx-background-color: #313244;">
                                    <VBox.margin>
                                        <Insets bottom="5.0" top="10.0" />
                                    </VBox.margin>
                                </Separator>

                                <!-- USER 6: FINANCE OFFICER GOALS -->
                                <Label text="USER 6: FINANCE OFFICER" textFill="#a6e3a1">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal9" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="9. Generate &amp; Issue Invoices" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal10" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="10. Process Customer Payments" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal11" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="11. Approve Car Financing &amp; Loans" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal12" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="12. Calculate Taxes &amp; Duty" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal13" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="13. Showroom Expenses" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal14" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="14. Process Employee Salary" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal15" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="15. Track Profit &amp; Revenue" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleGoal16" alignment="BASELINE_LEFT" style="-fx-background-color: #313244; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 12;" text="16. Financial Audit &amp; Tax Reports" />
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="55.0" style="-fx-background-color: #1e1e2e; -fx-padding: 0 20; -fx-border-color: #313244; -fx-border-width: 0 0 1 0;">
            <children>
                <Label fx:id="lblActiveViewTitle" text="Goal 1: Manage Inventory &amp; Showroom Cars" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentArea" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>
