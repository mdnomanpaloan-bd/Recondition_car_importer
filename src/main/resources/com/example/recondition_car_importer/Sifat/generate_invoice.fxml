<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #1e1e2e; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.recondition_car_importer.Sifat.GenerateInvoiceController">
    <children>
        <Label text="Generate &amp; Issue Invoices" textFill="WHITE">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox prefWidth="350.0" spacing="15.0" style="-fx-background-color: #2b2b3b; -fx-padding: 15; -fx-background-radius: 8;">
                    <children>
                        <Label text="Invoice Details" textFill="#a6adc8">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <Label text="Customer Name:" textFill="WHITE" />
                        <TextField fx:id="txtCustomerName" promptText="e.g. Tariq Hasan" />

                        <Label text="Select Vehicle:" textFill="WHITE" />
                        <ComboBox fx:id="comboSoldCar" maxWidth="1.7976931348623157E308" promptText="Choose Car" />

                        <Label text="Base Price (BDT):" textFill="WHITE" />
                        <TextField fx:id="txtBasePrice" promptText="e.g. 5000000" />

                        <Label text="Tax Rate (%):" textFill="WHITE" />
                        <TextField fx:id="txtTaxRate" text="15.0" promptText="e.g. 15.0" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleGenerateInvoice" style="-fx-background-color: #a6e3a1; -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-padding: 10;" text="Generate Invoice" />

                        <Label fx:id="lblMessage" textFill="#f9e2af" wrapText="true" />
                    </children>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" spacing="10.0">
                    <children>
                        <Label text="Invoice Document Preview" textFill="#a6adc8">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <TextArea fx:id="txtInvoicePreview" editable="false" prefHeight="400.0" style="-fx-control-inner-background: #181825; -fx-font-family: 'Courier New'; -fx-font-size: 13;" VBox.vgrow="ALWAYS" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
