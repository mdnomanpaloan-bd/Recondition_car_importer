<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #1e1e2e; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.recondition_car_importer.Sifat.VehiclePricingController">
    <children>
        <Label text="Set Vehicle Pricing &amp; Discounts" textFill="WHITE">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="pricingTable" HBox.hgrow="ALWAYS" style="-fx-background-color: #2b2b3b;">
                    <columns>
                        <TableColumn fx:id="colModel" prefWidth="200.0" text="Car Model" />
                        <TableColumn fx:id="colOriginalPrice" prefWidth="150.0" text="Original Price (BDT)" />
                        <TableColumn fx:id="colDiscount" prefWidth="120.0" text="Discount %" />
                        <TableColumn fx:id="colFinalPrice" prefWidth="160.0" text="Final Price (BDT)" />
                    </columns>
                </TableView>

                <VBox prefWidth="300.0" spacing="15.0" style="-fx-background-color: #2b2b3b; -fx-padding: 15; -fx-background-radius: 8;">
                    <children>
                        <Label text="Apply Special Discount" textFill="#a6adc8">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        
                        <Label text="Enter Discount Percentage (%)" textFill="WHITE" />
                        <TextField fx:id="txtDiscountPercent" promptText="e.g. 5.0" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleApplyDiscount" style="-fx-background-color: #a6e3a1; -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-padding: 10;" text="Apply Discount" />

                        <Separator style="-fx-background-color: #45475a;" />

                        <Label fx:id="lblFinalPrice" text="Final Price: BDT 0.00" textFill="#89b4fa" wrapText="true">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>

                        <Label fx:id="lblMessage" textFill="#f9e2af" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
