<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #1e1e2e; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.recondition_car_importer.Sifat.CustomerComplaintsController">
    <children>
        <Label text="Handle Customer Complaints &amp; Escalations" textFill="WHITE">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="complaintTable" HBox.hgrow="ALWAYS" style="-fx-background-color: #2b2b3b;">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="100.0" text="Complaint ID" />
                        <TableColumn fx:id="colCustomer" prefWidth="150.0" text="Customer" />
                        <TableColumn fx:id="colIssue" prefWidth="220.0" text="Issue Description" />
                        <TableColumn fx:id="colPriority" prefWidth="90.0" text="Priority" />
                        <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                    </columns>
                </TableView>

                <VBox prefWidth="320.0" spacing="15.0" style="-fx-background-color: #2b2b3b; -fx-padding: 15; -fx-background-radius: 8;">
                    <children>
                        <Label text="Resolution Panel" textFill="#a6adc8">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <Label text="Update Status:" textFill="WHITE" />
                        <ComboBox fx:id="comboStatus" maxWidth="1.7976931348623157E308" />

                        <Label text="Resolution Notes:" textFill="WHITE" />
                        <TextArea fx:id="txtResolution" prefHeight="130.0" promptText="Enter detailed resolution notes..." wrapText="true" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleSaveResolution" style="-fx-background-color: #a6e3a1; -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-padding: 10;" text="Save Resolution" />

                        <Label fx:id="lblMessage" textFill="#f9e2af" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
