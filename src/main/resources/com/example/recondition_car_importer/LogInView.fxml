<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.recondition_car_importer.LogInView">
   <children>
      <Label layoutX="175.0" layoutY="89.0" text="Welcome back! Let's take you to your account." textAlignment="CENTER" />
      <Label layoutX="267.0" layoutY="49.0" text="Login" textAlignment="CENTER">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="159.0" layoutY="132.0" text="Email" />
      <TextField fx:id="email_TF" layoutX="159.0" layoutY="156.0" prefHeight="26.0" prefWidth="283.0" />
      <Label layoutX="160.0" layoutY="191.0" text="Password" />
      <PasswordField fx:id="password_PF" layoutX="160.0" layoutY="215.0" prefHeight="26.0" prefWidth="281.0" />
      <Button layoutX="160.0" layoutY="265.0" mnemonicParsing="false" onAction="#loginContinue_OA" prefHeight="26.0" prefWidth="281.0" text="Continue" />
      <Label layoutX="160.0" layoutY="300.0" text="Don't have an account?" />
      <Button depthTest="ENABLE" layoutX="292.0" layoutY="300.0" mnemonicParsing="false" onAction="#signUp_OA" style="-fx-background-color: transparent; -fx-padding: 0;" text="Sign Up" textFill="#0e82c9" underline="true" />
      <CheckBox fx:id="showPassword_CB" layoutX="329.0" layoutY="191.0" mnemonicParsing="false" onAction="#showPassword_OA" text="Show Password" />
   </children>
</AnchorPane>
